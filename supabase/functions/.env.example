# Server-side secrets (Edge Functions + content scripts). Copy to supabase/functions/.env — never commit.
# dev -> GEMINI_API_KEY_DEV (synthetic data only), prod -> GEMINI_API_KEY_PROD
APP_ENV=dev
GEMINI_API_KEY_DEV=
GEMINI_API_KEY_PROD=
# confirm the current Flash model ID before the pilot
GEMINI_MODEL=gemini-3.1-flash-lite
# low = fast tutor replies (2.5-flash supports low/high)
GEMINI_THINKING=low
GEMINI_EMBED_MODEL=gemini-embedding-001
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
CAPTCHA_SECRET=
SUPABASE_ANON_KEY=
