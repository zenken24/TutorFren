{
  "expo": {
    "name": "TutorFren",
    "slug": "tutorfren",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.futureframe.tutorfren",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EEF7FA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.futureframe.tutorfren",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "TutorFren uses the microphone only to turn your voice into text. Recordings are never saved."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-image",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock guardian mode."
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],
    "scheme": "tutorfren",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "47f2ebe4-4308-4b0b-88a9-87401870992e"
      }
    },
    "owner": "zenken"
  }
}
