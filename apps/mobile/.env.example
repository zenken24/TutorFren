# Public values only. Never put a service-role or Gemini key in the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 once Google sign-in is configured in Supabase (docs/NEXT_STEPS.md -> Google sign-in)
EXPO_PUBLIC_GOOGLE_AUTH=0
# 1 = allow screenshots/screen recording of guardian screens (demo videos only)
EXPO_PUBLIC_ALLOW_SCREEN_CAPTURE=0
